  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f8fbfe",
  "theme_color": "#f8fbfe",
  "lang": "ru",
  "dir": "ltr",
  "categories": ["education", "productivity"],
  "launch_handler": {"client_mode": "navigate-existing"},
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Игры и симуляторы",
