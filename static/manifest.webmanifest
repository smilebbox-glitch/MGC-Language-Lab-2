      "url": "/?view=games",
      "icons": [{"src": "/icons/app-icon.svg", "sizes": "any", "type": "image/svg+xml"}]
    },
    {
      "name": "Темы",
      "short_name": "Темы",
      "description": "Открыть автомобильную лексику и темы",
      "url": "/?view=topics",
      "icons": [{"src": "/icons/app-icon.svg", "sizes": "any", "type": "image/svg+xml"}]
    },
    {
      "name": "Сценарии",
      "short_name": "Сценарии",
      "description": "Открыть рабочие производственные сценарии",
      "url": "/?view=roleplay",
      "icons": [{"src": "/icons/app-icon.svg", "sizes": "any", "type": "image/svg+xml"}]
    }
  ],
  "icons": [
    {
      "src": "/icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
