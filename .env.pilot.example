MGC_PORT=8080
POSTGRES_DB=mgc_languages
POSTGRES_USER=mgc_languages
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# local for first sandbox; oidc for corporate pilot
AUTH_MODE=local
REGISTRATION_ENABLED=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=
OIDC_STATE_SECRET=CHANGE_ME_RANDOM_32_BYTES_OR_MORE

# Local sandbox admin (ignored when AUTH_MODE=oidc)
MGC_ADMIN_USERNAME=admin
MGC_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_PASSWORD
MGC_ADMIN_DISPLAY_NAME=MGC Admin

# Corporate OIDC
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email groups
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME_CLAIM=name
OIDC_GROUPS_CLAIM=groups
OIDC_DEPARTMENT_CLAIM=department
OIDC_ADMIN_GROUP=
OIDC_EDITOR_GROUP=
OIDC_MANAGER_GROUP=

METRICS_TOKEN=CHANGE_ME_METRICS_BEARER_TOKEN
MAX_IMPORT_BYTES=5242880
MAX_IMPORT_ROWS=5000
MAX_XLSX_UNCOMPRESSED_BYTES=26214400

# Offline pronunciation (primary) + browser SpeechSynthesis fallback
TTS_ENABLED=true
TTS_VOICE_CHINESE=zh
TTS_VOICE_ENGLISH=en-us
TTS_MAX_CHARS=300

# TTS resilience / privacy: POST-only in pilot + local circuit breaker + ephemeral bounded cache
TTS_TIMEOUT_SECONDS=8
TTS_CONCURRENCY=2
TTS_FAILURE_THRESHOLD=3
TTS_CIRCUIT_COOLDOWN_SECONDS=30
TTS_HEALTH_TTL_SECONDS=30
TTS_DISK_CACHE_ENABLED=true
TTS_CACHE_PERSISTENCE=ephemeral
TTS_LEGACY_GET_ENABLED=false
TTS_DISK_CACHE_MAX_MB=64
TTS_DISK_CACHE_TTL_HOURS=24

# Readiness policy gates. Technical sandbox may keep OIDC/secure-cookie requirements false.
# Corporate controlled pilot should set both to true after TLS + OIDC are connected.
READY_REQUIRE_OIDC=false
READY_REQUIRE_SECURE_COOKIE=false
READY_REQUIRE_SCHEMA_HEAD=true
READY_REQUIRE_REGISTRATION_DISABLED=true
READY_REQUIRE_METRICS_TOKEN=true
EXPECTED_ALEMBIC_HEAD=c57d0a31f570

# Serialize Alembic if more than one app instance starts together.
MIGRATION_LOCK_TIMEOUT_SECONDS=120
MIGRATION_ADVISORY_LOCK_ID=5322026

# v5.4 reliability / DB failure containment
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_READY_MAX_LATENCY_MS=1500

# v5.4 retention / maintenance. Confirm final values with IT/Security/HR before production.
AUDIT_RETENTION_DAYS=180
OPERATIONAL_EVENT_RETENTION_DAYS=30
NUDGE_RETENTION_DAYS=60
MAINTENANCE_INTERVAL_SECONDS=21600

# v5.5 Pilot Operations: internal SLOs, alerts and recovery state.
# These values are pilot targets, not a contractual external SLA.
PILOT_SERVICE_WINDOW=business-hours
PILOT_SLA_MODE=internal-non-contractual
SLO_WINDOW_MINUTES=60
SLO_AVAILABILITY_TARGET_PERCENT=99.0
SLO_ERROR_RATE_TARGET_PERCENT=1.0
SLO_P95_TARGET_MS=2000
ALERT_ERROR_RATE_PERCENT=2.0
ALERT_P95_MS=3000
ALERT_DB_LATENCY_MS=1000
ALERT_CLEANUP_BACKLOG=1000
RECOVERY_STABLE_SECONDS=60
ALERT_RETENTION_DAYS=90

# v5.6 Pilot Governance & Rollout
PILOT_DAILY_XP_CAP=2500
PILOT_DAILY_GAME_START_CAP=150
PILOT_DAILY_TTS_CAP=500
PILOT_DAILY_PRACTICE_CAP=300
PILOT_EXPORT_MAX_USERS=10000
PILOT_USAGE_RETENTION_DAYS=90

# v5.7 Security / content governance / adaptive learning
RLS_ENABLED=true
TERM_APPROVAL_REQUIRED=true
SRS_DAILY_REVIEW_LIMIT=30
QUESTION_QUALITY_MIN_ATTEMPTS=20
QUESTION_QUALITY_LOW_ACCURACY=0.35
QUESTION_QUALITY_HIGH_ACCURACY=0.97
OTEL_ENABLED=false
OTEL_SERVICE_NAME=mgc-languages
OTEL_EXPORTER_OTLP_ENDPOINT=
READY_REQUIRE_RLS=true
READY_REQUIRE_TERM_APPROVAL=true

# v5.7.1 database observability / recovery evidence
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_ALERT_PERCENT=80
DB_QUERY_WINDOW_MINUTES=15
DB_SLOW_QUERY_THRESHOLD_MS=500
DB_SLOW_QUERY_ALERT_COUNT=5
BACKUP_MAX_AGE_MINUTES=1560
RESTORE_EVIDENCE_MAX_AGE_DAYS=30
RPO_TARGET_MINUTES=1440
RTO_TARGET_MINUTES=60
RECOVERY_EVIDENCE_REQUIRED=true
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
