# Local development only. Use .env.pilot.example for IT pilot.
MGC_PORT=8080
MGC_ADMIN_USERNAME=admin
MGC_ADMIN_PASSWORD=CHANGE_ME_DEV_PASSWORD
MGC_ADMIN_DISPLAY_NAME=MGC Admin

TTS_ENABLED=true

# No microphone/voice recording is used. Pronunciation is playback only.
TTS_DISK_CACHE_ENABLED=true

# v5.4 pronunciation/readiness privacy
TTS_LEGACY_GET_ENABLED=true
TTS_CACHE_PERSISTENCE=persistent

# v5.7 optional local controls
RLS_ENABLED=false
TERM_APPROVAL_REQUIRED=false
OTEL_ENABLED=false

# Optional v5.7.1 operational telemetry (development defaults)
DB_SLOW_QUERY_THRESHOLD_MS=500
DB_QUERY_WINDOW_MINUTES=15
RECOVERY_EVIDENCE_REQUIRED=false
