# MGC Languages — VM deployment profile (internal corporate pilot)
# Copy to .env.vm only through deploy/vm/setup_vm.sh; the script generates secrets.
# Never commit .env.vm or deploy/vm/runtime/.

MGC_BIND_ADDRESS=0.0.0.0
# Legacy CPU-only VM launcher compatibility; the production HTTPS kit uses MGC_HTTPS_PORT.
MGC_PORT=8080
MGC_HTTPS_PORT=443
MGC_PUBLIC_HOST=CHANGE_ME_VM_IP_OR_DNS
MGC_TLS_MODE=self-signed

POSTGRES_DB=mgc_languages
POSTGRES_USER=mgc_languages
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_MAX_CONNECTIONS=80

AUTH_MODE=local
REGISTRATION_ENABLED=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
# setup_vm.sh extends this list with the detected/provided VM host.
MGC_TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=
OIDC_STATE_SECRET=CHANGE_ME_OIDC_SECRET

MGC_ADMIN_USERNAME=admin
MGC_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MGC_ADMIN_DISPLAY_NAME=MGC Admin
MGC_ADMIN_DEPARTMENT=Администрация
MGC_ADMIN_SYNC_CREDENTIALS=true

METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# CPU-only VM profile. Browser speech synthesis remains available on client devices.
TTS_ENABLED=false
TTS_DISK_CACHE_ENABLED=false
TTS_LEGACY_GET_ENABLED=false

# Keep the established CPU-only compatibility profile at one worker.
WEB_CONCURRENCY=1
UVICORN_LIMIT_CONCURRENCY=200
UVICORN_BACKLOG=1024
UVICORN_KEEP_ALIVE_SECONDS=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECTION_RESERVE=20
CAPACITY_EXPECTED_AUX_CONNECTIONS=8

RLS_ENABLED=true
TERM_APPROVAL_REQUIRED=true
PILOT_DAILY_XP_CAP=2500
PILOT_DAILY_GAME_START_CAP=150
PILOT_DAILY_TTS_CAP=0
PILOT_DAILY_PRACTICE_CAP=300

# Container limits. Recommended VM: 4 vCPU / 8 GB RAM / 40 GB disk.
MGC_APP_MEMORY_LIMIT=2g
MGC_APP_CPU_LIMIT=2.0
MGC_DB_MEMORY_LIMIT=1g
MGC_DB_CPU_LIMIT=1.0
MGC_NGINX_MEMORY_LIMIT=256m
MGC_NGINX_CPU_LIMIT=0.25
