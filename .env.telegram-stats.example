# Add these lines to your stack env file (.env.lan / .env.pilot / .env.vm).
# 1) Create a bot with @BotFather and copy its token.
# 2) Add the bot to your channel as an administrator with permission to post.
# 3) Channel id: -100XXXXXXXXXX (or @channelname for a public channel).
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
TELEGRAM_CHAT_ID=CHANGE_ME_CHANNEL_ID
STATS_TIMEZONE=Europe/Moscow
STATS_SEND_TIME=18:00
